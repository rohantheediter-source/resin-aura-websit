# ========================================================
# ResinAura E-Commerce Production & Development Environment
# ========================================================

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# WhatsApp Artisan Business Number (with country code, no + or spaces)
# Example: 919876543210 (Default)
NEXT_PUBLIC_WHATSAPP_NUMBER=919876543210

# Razorpay Online Payment Gateway
# Get these from https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyId
RAZORPAY_KEY_ID=rzp_test_YourTestKeyId
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere

# Supabase PostgreSQL Database & Auth (Optional for cloud sync)
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Admin Portal Master Passcode (Default: admin123)
ADMIN_PASSCODE=admin123

